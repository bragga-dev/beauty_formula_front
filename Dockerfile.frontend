# =========================================================
# Dockerfile do frontend (formula-da-beleza)
# Salve este arquivo como "Dockerfile" na raiz do projeto
# formula-da-beleza-frontend/formula-da-beleza/
# =========================================================

# ---- Stage 1: build da SPA (Vite + React) ----
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# URL da API relativa: o próprio Nginx faz o proxy para /api,
# então frontend e backend ficam na mesma origem (sem CORS!)
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---- Stage 2: serve os arquivos estáticos com Nginx ----
FROM nginx:1.27-alpine

# remove config default do nginx e coloca a nossa
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
